<div id="booking_body">
  <h3 class="h3">Booking page</h3>
  <h1 class="h3"><%= h(space_id.space_name) %></h1>
  <form action="/request" method="post">
    <input type="hidden" name="csrf_token" value="<%= csrf_token %>">
    <table class="booking" border="6">
      <tr>
        <td>
          <p>Space description: <%= h(space_id.space_description) %></p>
          <p>Space price: <%= h(space_id.space_price) %></p>
          <p>Space available from: <%= h(space_id.availability_start) %> to <%= h(space_id.availability_end) %></p>
          <label>Start date <input class="booking-date" type="date" name="availability_start" value="<%= h(space_id.availability_start) %>" required></label>
          <label>End date <input class="booking-date" type="date" name="availability_end" value="<%= h(space_id.availability_end) %>" required></label>
          <input type="submit" value="Review request">
        </td>
      </tr>
    </table>
  </form>
</div>
