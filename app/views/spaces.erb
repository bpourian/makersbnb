<div id="back">
  <h1>Welcome <%= h(current_user.username) %></h1>
  <table class="table" border="2">
    <tbody>
      <% @spaces.each do |space| %>
        <tr>
          <td>
            <p>Space name: <%= h(space.space_name) %></p>
            <p>Space price: <%= h(space.space_price) %></p>
            <form action="/spaces/booking" method="post">
              <input type="hidden" name="csrf_token" value="<%= csrf_token %>">
              <input type="hidden" name="post_id" value="<%= h(space.id) %>">
              <input type="submit" value="Book here">
            </form>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
